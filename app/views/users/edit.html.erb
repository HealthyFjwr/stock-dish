<% content_for :title, "アカウント設定 | StockDish" %>

<div class="mx-auto max-w-4xl space-y-7">
  <div>
    <p class="text-xs font-bold tracking-[0.2em] text-[#718078]">ACCOUNT</p>
    <h1 class="mt-2 text-3xl font-bold tracking-tight text-[#285b46]">アカウント設定</h1>
    <p class="mt-2 text-sm text-[#718078]">StockDishのアカウント情報を管理します。</p>
  </div>

  <section class="rounded-2xl border border-[#e7e9e1] bg-white p-5 shadow-[0_2px_12px_rgba(40,91,70,0.03)] sm:p-7">
    <div class="mb-6 border-b border-[#eef0e9] pb-4">
      <h2 class="text-lg font-bold text-[#34463b]">プロフィール</h2>
      <p class="mt-1 text-sm text-[#8a968d]">表示名を変更できます。</p>
    </div>

    <%= form_with model: @user, url: user_path, method: :patch, class: "max-w-xl" do |f| %>
      <div class="mb-6">
        <%= f.label :username, class: "mb-1.5 block text-sm font-semibold text-[#526258]" %>
        <%= f.text_field :username, autocomplete: "username", required: true, class: "w-full rounded-xl border border-[#dce2d8] bg-[#fcfdfb] px-4 py-3 text-sm text-[#34463b] outline-none transition focus:border-[#6e9678] focus:ring-2 focus:ring-[#285b46]/10" %>
      </div>
      <div class="flex flex-col-reverse gap-3 sm:flex-row sm:justify-end">
        <%= link_to t(".cancel"), dashboard_path, class: "rounded-xl border border-[#dce2d8] px-5 py-3 text-center text-sm font-semibold text-[#526258] transition hover:bg-[#f5f7f1]" %>
        <%= f.submit t(".submit"), class: "rounded-xl bg-[#285b46] px-6 py-3 text-sm font-bold text-white transition hover:bg-[#1f4938]" %>
      </div>
    <% end %>
  </section>
</div>
