<div class="min-h-screen flex items-center justify-center bg-linear-to-br from-green-50 to-white px-4">
  <div class="w-full max-w-md bg-white rounded-2xl shadow-sm border border-gray-200 p-8">
    <h1 class="text-xl font-bold text-gray-800 text-center mb-6"><%= t(".user_edit") %></h1>

    <%= form_with model: @user, url: user_path, method: :patch do |f| %>
      <div class="mb-6">
        <%= f.label :username, class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.text_field :username, class: "w-full border border-gray-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-green-500" %>
      </div>

      <div class="flex justify-end gap-3">
        <%= link_to t(".cancel"), dashboard_path, class: "px-4 py-2 rounded-lg text-gray-600 hover:bg-gray-50 transition" %>
        <%= f.submit t(".submit"), class: "px-6 py-2 bg-green-700 text-white rounded-lg font-bold hover:bg-green-900 transition" %>
      </div>
    <% end %>
  </div>
</div>
