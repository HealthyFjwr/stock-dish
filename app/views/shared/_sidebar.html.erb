<aside class="flex w-full shrink-0 flex-col border-b border-[#e8ebe3] bg-white px-4 py-4 md:sticky md:top-0 md:h-screen md:w-56 md:border-b-0 md:border-r md:px-4 md:py-7">
  <%= link_to dashboard_path, class: "mb-4 px-2 md:mb-12 md:px-3" do %>
    <span class="block text-[25px] font-bold tracking-tight text-[#285b46]">StockDish</span>
    <span class="mt-0.5 block text-[11px] text-[#718078]">食材を、ひと皿につなぐ。</span>
  <% end %>

  <nav aria-label="メインメニュー" class="flex gap-1 overflow-x-auto md:flex-col md:gap-2">
    <%= link_to dashboard_path, class: "flex shrink-0 items-center gap-3 rounded-xl bg-[#dfedb9] px-3 py-3 text-sm font-bold text-[#285b46] md:w-full" do %>
      <span class="w-5 text-center text-lg leading-none" aria-hidden="true">⌂</span><span>ホーム</span>
    <% end %>
    <%= link_to "#", class: "flex shrink-0 items-center gap-3 rounded-xl px-3 py-3 text-sm text-[#718078] transition hover:bg-[#f5f7f1] hover:text-[#285b46] md:w-full" do %>
      <span class="w-5 text-center text-base leading-none" aria-hidden="true">◫</span><span>食材一覧</span>
    <% end %>
    <%= link_to user_seasonings_path, class: "flex shrink-0 items-center gap-3 rounded-xl px-3 py-3 text-sm text-[#718078] transition hover:bg-[#f5f7f1] hover:text-[#285b46] md:w-full" do %>
      <span class="w-5 text-center text-base leading-none" aria-hidden="true">▤</span><span>調味料一覧</span>
    <% end %>
    <%= link_to "#", class: "flex shrink-0 items-center gap-3 rounded-xl px-3 py-3 text-sm text-[#718078] transition hover:bg-[#f5f7f1] hover:text-[#285b46] md:w-full" do %>
      <span class="w-5 text-center text-base leading-none" aria-hidden="true">✧</span><span>レシピ提案</span>
    <% end %>
    <%= link_to "#", class: "flex shrink-0 items-center gap-3 rounded-xl px-3 py-3 text-sm text-[#718078] transition hover:bg-[#f5f7f1] hover:text-[#285b46] md:w-full" do %>
      <span class="w-5 text-center text-base leading-none" aria-hidden="true">◇</span><span>ブックマーク</span>
    <% end %>
  </nav>

  <div class="mt-auto hidden border-t border-[#eef0e9] pt-4 md:block">
    <%= link_to edit_user_path, class: "flex items-center gap-3 rounded-xl px-3 py-2 text-sm text-[#718078] transition hover:bg-[#f5f7f1] hover:text-[#285b46]" do %>
      <span class="w-5 text-center" aria-hidden="true">⚙</span><span>設定</span>
    <% end %>
  </div>
</aside>
