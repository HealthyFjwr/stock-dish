<% content_for :title, "ログイン | StockDish" %>

<div class="mx-auto grid min-h-[calc(100vh-8rem)] max-w-4xl items-center gap-8 py-6 md:grid-cols-2 md:gap-12">
  <section class="relative overflow-hidden rounded-3xl bg-[#285b46] px-7 py-9 text-white sm:px-9 md:py-12">
    <p class="text-2xl font-bold tracking-tight">Stock<span class="text-[#dfedb9]">Dish</span></p>
    <div class="mt-8 max-w-sm">
      <p class="text-xs font-bold tracking-[0.2em] text-[#d9e9bf]">WELCOME BACK</p>
      <h1 class="mt-3 text-2xl font-bold leading-snug sm:text-3xl">おかえりなさい。<br>今日のキッチンを開きましょう。</h1>
      <p class="mt-3 text-sm leading-6 text-white/75">ストックを確認して、今夜のごはんを考えましょう。</p>
    </div>
    <div class="absolute -bottom-8 -right-4 flex h-32 w-32 items-center justify-center rounded-full bg-white/10 text-6xl" aria-hidden="true">🥗</div>
  </section>

  <section class="rounded-3xl border border-[#e7e9e1] bg-white p-6 shadow-[0_6px_28px_rgba(40,91,70,0.06)] sm:p-8">
    <p class="text-xs font-bold tracking-[0.2em] text-[#718078]">LOG IN</p>
    <h2 class="mt-2 text-2xl font-bold text-[#285b46]">ログイン</h2>
    <p class="mt-2 text-sm text-[#718078]">登録したメールアドレスでログインしてください。</p>

    <%= form_with url: login_path, class: "mt-7 space-y-5" do |f| %>
      <div>
        <%= f.label :email, t(".email"), class: "mb-1.5 block text-sm font-semibold text-[#526258]" %>
        <%= f.email_field :email, autocomplete: "email", required: true, class: "w-full rounded-xl border border-[#dce2d8] bg-[#fcfdfb] px-4 py-3 text-sm text-[#34463b] outline-none transition placeholder:text-[#a0aaa1] focus:border-[#6e9678] focus:ring-2 focus:ring-[#285b46]/10" %>
      </div>
      <div>
        <div class="mb-1.5 flex items-center justify-between"><%= f.label :password, t(".password"), class: "block text-sm font-semibold text-[#526258]" %></div>
        <%= f.password_field :password, autocomplete: "current-password", required: true, class: "w-full rounded-xl border border-[#dce2d8] bg-[#fcfdfb] px-4 py-3 text-sm text-[#34463b] outline-none transition focus:border-[#6e9678] focus:ring-2 focus:ring-[#285b46]/10" %>
      </div>
      <%= f.submit t(".submit"), class: "w-full rounded-xl bg-[#285b46] px-5 py-3.5 text-sm font-bold text-white transition hover:bg-[#1f4938] focus:outline-none focus:ring-2 focus:ring-[#285b46] focus:ring-offset-2" %>
    <% end %>

    <p class="mt-6 text-center text-sm text-[#718078]">アカウントをお持ちでない方は <%= link_to "新規登録", new_user_path, class: "font-bold text-[#285b46] underline decoration-[#b6c9ad] underline-offset-4 hover:text-[#1f4938]" %></p>
    <%= link_to "トップページへ戻る", root_path, class: "mt-5 block text-center text-xs font-medium text-[#8a968d] hover:text-[#285b46]" %>
  </section>
</div>
